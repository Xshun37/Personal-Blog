---
import { Icon } from "astro-icon/components";
import KnowledgeLayout from "@/components/pages/knowledge/KnowledgeLayout.astro";
import { knowledgeConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
	getKnowledgeEntries,
	getKnowledgeTaxonomy,
	type KnowledgeTaxonomy,
} from "@/utils/knowledge-utils";

interface Props {
	kind: KnowledgeTaxonomy;
}

const { kind } = Astro.props;
const entries = await getKnowledgeEntries();
const items = getKnowledgeTaxonomy(entries, kind);
const label = i18n(kind === "category" ? I18nKey.categories : I18nKey.tags);
const icon =
	kind === "category"
		? "material-symbols:folder-open"
		: "material-symbols:tag-rounded";
---

<KnowledgeLayout title={`${knowledgeConfig.title} · ${label}`}>
	<div class="card-base p-6 md:p-8 flex flex-wrap gap-3" data-scroll-content>
		{items.map((item) => (
			<a href={item.url} class:list={["inline-flex items-center gap-2 px-4 py-2 transition-colors", kind === "tag" ? "tag-item" : "category-pill"]}>
				<Icon name={icon} />
				<span>{item.name}</span>
				<span class="text-sm">{item.count}</span>
			</a>
		))}
		{items.length === 0 && <p class="text-30">{i18n(I18nKey.noData)}</p>}
	</div>
</KnowledgeLayout>
