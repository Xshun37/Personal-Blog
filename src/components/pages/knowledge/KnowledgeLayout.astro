---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import { knowledgeConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";
import "@/styles/pages/common.css";

interface Props {
	title?: string;
	description?: string;
	headings?: MarkdownHeading[];
}

const {
	title = knowledgeConfig.title,
	description = knowledgeConfig.description,
	headings = [],
} = Astro.props;
const links = [
	{ label: "知识卡片", path: "/knowledge/" },
	{ label: i18n(I18nKey.categories), path: "/knowledge/categories/" },
	{ label: i18n(I18nKey.tags), path: "/knowledge/tags/" },
];
---

<MainGridLayout title={title} description={description} headings={headings}>
	<section class="page-shell knowledge-page">
		<header class="card-base page-header">
			<div class="page-heading">
				<div class="page-icon" aria-hidden="true">
					<Icon name="material-symbols:menu-book-rounded" />
				</div>
				<div>
					<h2>{title}</h2>
					{description && <p>{description}</p>}
				</div>
			</div>
			<nav class="col-span-full flex flex-wrap gap-2" aria-label={knowledgeConfig.title}>
				{links.map(({ label, path }) => (
					<a href={url(path)} class="category-pill px-4 py-1.5 text-sm transition-colors" data-active={Astro.url.pathname === url(path) ? "" : undefined} aria-current={Astro.url.pathname === url(path) ? "page" : undefined}>
						{label}
					</a>
				))}
			</nav>
		</header>
		<slot />
	</section>
</MainGridLayout>
