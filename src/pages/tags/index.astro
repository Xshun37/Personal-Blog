---
import TagIndex from "@/components/pages/taxonomy/TagIndex.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const tags = (await getTagList()).map((tag) => ({
	...tag,
	url: getTagUrl(tag.name),
}));
const title = i18n(I18nKey.tags);
---

<MainGridLayout title={title} description={i18n(I18nKey.allTags)}>
	<TagIndex tags={tags} title={title} entryCountLabel={i18n(I18nKey.postsCount)} />
</MainGridLayout>
