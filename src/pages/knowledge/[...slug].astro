---
import { render } from "astro:content";
import ButtonTag from "@/components/common/ButtonTag.astro";
import Markdown from "@/components/common/Markdown.astro";
import KnowledgeLayout from "@/components/pages/knowledge/KnowledgeLayout.astro";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import {
	getKnowledgeCategory,
	getKnowledgeEntries,
	getKnowledgeFilterUrl,
	type KnowledgeEntry,
} from "@/utils/knowledge-utils";
import { removeFileExtension } from "@/utils/url-utils";

export async function getStaticPaths() {
	const entries = await getKnowledgeEntries();
	return entries.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { entry },
	}));
}

interface Props {
	entry: KnowledgeEntry;
}

const { entry } = Astro.props;
const { title, description, tags, published, updated, draft } = entry.data;
const category = getKnowledgeCategory(entry);
const { Content, headings } = await render(entry);
---

<KnowledgeLayout title={title} description={description} headings={headings}>
	<article class="card-base px-6 md:px-9 py-8" data-pagefind-body data-scroll-content>
		<header class="mb-6">
			<h2 class="text-3xl font-bold text-90 break-words" data-pagefind-meta="title" data-pagefind-weight="10">{title}</h2>
			{draft && <p class="text-sm text-30 mt-2">草稿</p>}
			<div class="flex flex-wrap gap-3 text-sm text-30 mt-3" data-pagefind-ignore>
				<a href={getKnowledgeFilterUrl("category", category)} class="hover:text-(--primary)">{category}</a>
				<time datetime={published.toISOString()}>发布于 {formatDateToYYYYMMDD(published)}</time>
				{updated && <time datetime={updated.toISOString()}>更新于 {formatDateToYYYYMMDD(updated)}</time>}
			</div>
			{description && <p class="text-50 mt-4">{description}</p>}
			{tags.length > 0 && <div class="flex flex-wrap gap-2 mt-4" data-pagefind-ignore>
				{tags.map((tag) => <ButtonTag href={getKnowledgeFilterUrl("tag", tag)}>{tag}</ButtonTag>)}
			</div>}
		</header>
		<Markdown class="markdown-content"><Content /></Markdown>
	</article>
</KnowledgeLayout>
