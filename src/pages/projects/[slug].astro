---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import ProjectDetail from "@/components/pages/projects/ProjectDetail.astro";
import { siteConfig } from "@/config";
import { getSortedProjects } from "@/utils/content-utils";
import { removeFileExtension } from "@/utils/url-utils";

if (!siteConfig.pages.projects) return Astro.redirect("/404/");

export const getStaticPaths = (async () => {
	const entries = await getSortedProjects();
	return entries.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
---

<ProjectDetail entry={entry} />
